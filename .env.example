# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# HubSpot private app token (CRM contacts/deals/lists/owners read scopes)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=4021060

# Vertex AI (Gemini). Local dev: path to a service-account key file (or gcloud ADC).
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json
# Production (Vercel): the full service-account key JSON as one string (raw JSON or base64).
GCP_SERVICE_ACCOUNT_JSON=
# Optional overrides
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
COPILOT_VERTEX_MODEL=gemini-2.5-flash

# Slack escalation tags (defaults: @Jonathan @Dean)
SLACK_TAG_JONATHAN=
SLACK_TAG_DEAN=

# "Teach Agent": commits learned rules to docs/BIZOPS_PLAYBOOK.md on main.
# Fine-grained token with Contents: Read and write on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=JonathanMaderer/bizops-copilot-engine

# Monday.com shadow-pilot webhook (API token with boards read + updates write)
MONDAY_API_TOKEN=

# Optional: where feedback is appended (defaults to data/corrections.jsonl locally, /tmp on Vercel)
FEEDBACK_FILE=
